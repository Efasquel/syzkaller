gha-creds-*.json

# the experiments: hand-written manager configs, tracked (the global *.cfg
# rule above is syzkaller's own)
!/config/*.cfg

# fuzz-session.py registry
/sessions/

# fuzz-campaign.py runs. A campaign's definition and README are tracked -- the
# experiment and its write-up -- everything else in its folder is runtime
# (corpora, logs, cores). git cannot re-include a file under an excluded dir,
# so exclude contents, re-include the subdirs, exclude their contents, then
# re-include the two files.
/campaigns/*
!/campaigns/*/
/campaigns/*/*
!/campaigns/*/campaign.json
!/campaigns/*/plan.json
!/campaigns/*/README.md
/bugs/
/run/
/STOP

# triage.py runtime state
/triage/

# notes
.notes/

# test
.test/

# python
__pycache__/
# campaign-redesign simulator output
/playground/tree/
